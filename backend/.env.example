NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=anna_english_school

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:5173

# PromptPay phone number (10 digits) or citizen/tax ID (13 digits)
PROMPTPAY_ID=0812345678

# Receipt issuer information
RECEIPT_ISSUER_NAME=Anna English School
RECEIPT_TAX_ID=replace-with-school-tax-id
RECEIPT_ADDRESS=replace-with-school-address
